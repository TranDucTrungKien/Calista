# ============================================================
# Calista Backend — Environment Variables
# Copy file này thành .env và điền các giá trị tương ứng
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/calista

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string-access
JWT_REFRESH_SECRET=replace-with-a-long-random-string-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — Angular dev server
CORS_ORIGINS=http://localhost:4200

# Cookies
COOKIE_SECURE=false

# Email (Nodemailer — dùng SMTP của Gmail hoặc Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Calista <no-reply@calista.vn>"

# Cloudinary (upload ảnh — tùy chọn, có thể để trống ở dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment — MoMo (sandbox stub)
MOMO_PARTNER_CODE=MOMO_SANDBOX
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:4200/orders/result
MOMO_IPN_URL=http://localhost:5000/api/payment/callback

# Payment — ZaloPay (sandbox stub)
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_REDIRECT_URL=http://localhost:4200/orders/result
ZALOPAY_CALLBACK_URL=http://localhost:5000/api/payment/callback

# Frontend URL (dùng cho link trong email)
FRONTEND_URL=http://localhost:4200

# ============================================================
# TikTok Shop Open API
# Lấy thông tin từ TikTok Developer Portal: https://partner.tiktokshop.com/
# ============================================================

# App credentials (TikTok Developer Portal → App Management)
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# OAuth redirect URI — phải trùng khớp với URL đã đăng ký trong TikTok Developer Portal
# Dev:  http://localhost:5000/api/tiktok/oauth/callback
# Prod: https://calista.vn/api/tiktok/oauth/callback
TIKTOK_REDIRECT_URI=http://localhost:5000/api/tiktok/oauth/callback

# Webhook signing secret — thường giống TIKTOK_APP_SECRET
TIKTOK_WEBHOOK_SECRET=

# API endpoints (không cần thay đổi trừ khi dùng sandbox)
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE=https://auth.tiktok-shops.com

# Số phút trước khi hết hạn sẽ tự động làm mới access token (mặc định: 5)
TIKTOK_TOKEN_REFRESH_MARGIN_MIN=5
